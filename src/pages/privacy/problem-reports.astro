  ["The Floe sender", "https://github.com/frostyard/snosi/blob/main/docs/adr/0030-floe-sends-problem-reports-with-admin-consent.md", "frostyard/snosi ADR-0030: how Floe sends reports after an administrator agrees."],
  ["ChairLift", "https://github.com/frostyard/chairlift/blob/main/docs/adr/0015-problems-page-and-opt-in-reporting.md", "frostyard/chairlift: the Problems page and the desktop sender."],
