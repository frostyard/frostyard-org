const intake = "https://github.com/frostyard/problem-intake/blob/main";
const sources: Array<[string, string, string]> = [
  ["The decision", `${core}/docs/adr/0069-report-problems-local-first-opt-in-with-one-sender-per-host.md`, "frostyard/core ADR-0069: local first, opt-in, one sender per computer."],
  ["The report format", `${core}/docs/specs/problem-report.md`, "frostyard/core: every field, every value, and the rules for new versions."],
