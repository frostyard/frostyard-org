---
import Site from "../layouts/Site.astro";
const projects = [
  {
    name: "Millhouse",
    label: "Mill run supervisor",
    mark: "MH",
    title: "One supervisor for every mill run.",
    body: "A cross-project supervisor for launching and watching mill runs. It gives every run a stable identity, tracks liveness and phase across CLI, HTTP, and MCP surfaces, and can stop the exact run you meant to stop.",
    points: ["Launch mill runs against any repo and source", "Liveness and phase visibility for every run", "Stop the exact run, not a guess by name", "CLI, HTTP, and MCP control interfaces"],
    command: "millhouse mill <repo> <source>",
    href: "https://github.com/frostyard/millhouse",
  },
];
---
<Site title="Projects | Frostyard" description="Frostyard's open projects: tools, services, and experiments built for layered, updateable systems." active="projects" footerLabel="Explore tools →" footerHref="/tools">
  <header class="hero">
    <p class="eyebrow"><i></i> Open projects</p>
    <h1>Built in the open.<br /><em>Shared without ceremony.</em></h1>
    <p class="lede">This page collects Frostyard's open projects: the software built to support layered, updateable systems, published for anyone to inspect or use.</p>
  </header>

  <section class="projects" aria-label="Frostyard projects">
    {projects.map(project => <article class="project">
      <div class="project-head"><div class="mark">{project.mark}</div><div><p>{project.label}</p><h2>{project.name}</h2></div><a href={project.href} aria-label={`Open ${project.name} source`}>↗</a></div>
      <div class="project-body"><div><h3>{project.title}</h3><p>{project.body}</p><code>{project.command}</code></div><ul>{project.points.map(point => <li>{point}</li>)}</ul></div>
      <a class="inspect" href={project.href}>Inspect {project.name} <span>↗</span></a>
    </article>)}
  </section>
</Site>

<style>
  .hero{padding:7rem 0 5.5rem;max-width:820px}
  .hero h1{font-size:var(--text-display-size);line-height:var(--text-display-lh);letter-spacing:var(--text-display-ls);font-weight:var(--text-display-weight);margin:0}
  .hero h1 em{font-family:var(--font-serif-accent);font-weight:400;color:var(--ice)}
  .lede{font-size:var(--text-lede-size);color:var(--text-muted);max-width:580px;margin:2rem 0 0}
  .projects{display:grid;gap:1rem}
  .project{background:linear-gradient(135deg,#0e3049,#081b2c);border:1px solid var(--line);padding:var(--tool-pad)}
  .project-head{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1rem;border-bottom:1px solid var(--line);padding-bottom:1.6rem}
  .mark{display:grid;place-items:center;width:48px;height:48px;border:1px solid #aee9ff80;background:#135477;border-radius:50%;font-weight:800;font-size:.75rem;color:var(--ice)}
  .project-head p{font-size:.7rem;text-transform:uppercase;letter-spacing:.15em;color:#84bed5;margin:0}
  .project-head h2{font-size:2rem;line-height:1;letter-spacing:-.06em;margin:.2rem 0 0}
  .project-head>a{font-size:1.4rem;color:var(--ice)}
  .project-body{display:grid;grid-template-columns:1.2fr .8fr;gap:4rem;padding:2.2rem 0}
  .project-body h3{font-size:1.45rem;letter-spacing:-.04em;margin:0 0 .7rem}
  .project-body p{font-size:var(--text-body-size);color:var(--text-muted);margin:0 0 1.5rem}
  .project-body code{font-family:var(--font-mono);font-size:.73rem;color:var(--text-mono-accent);background:var(--surface-code);padding:.55rem .7rem;display:inline-block}
  .project-body ul{list-style:none;margin:0;padding:0}
  .project-body li{border-top:1px solid var(--line);padding:.75rem 0;color:#c0dce9;font-size:.85rem}
  .project-body li:before{content:"✦";color:#67cdf3;font-size:.63rem;margin-right:.6rem}
  .inspect{font-size:.8rem;font-weight:700;color:#93e0fb}
  .inspect span{margin-left:.3rem}
  @media(max-width:800px){
    .hero{padding:5rem 0 4rem}
    .project{padding:1.4rem}
    .project-body{grid-template-columns:1fr;gap:2rem}
  }
</style>
