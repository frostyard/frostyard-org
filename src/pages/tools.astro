---
import Site from "../layouts/Site.astro";
const tools = [
  {
    name: "Firn",
    label: "Operating system installer",
    mark: "FN",
    title: "Install the image, without blurring the boundary.",
    body: "A guided installer for published Frostyard images. Firn selects and verifies the payload, makes storage and security choices explicit, and confirms the destructive target before writing.",
    points: ["Install the four bootc products", "Verify image identity before writing", "Make encryption and unlock choices explicit", "Confirm the exact target disk"],
    command: "Installer ISO  ·  guided local install",
    href: "https://github.com/frostyard/firn",
  },
  {
    name: "updex",
    label: "System extension manager",
    mark: "UX",
    title: "Extensions, with a proper control surface.",
    body: "A Go CLI and SDK for discovering, enabling, updating, and retiring systemd-sysext features. It reads ordinary transfer definitions, verifies published artifacts, and keeps version retention bounded.",
    points: ["Feature and component discovery", "SHA256 manifests and published signature verification", "Retry-aware downloads and automatic decompression", "CLI, JSON output, and Go SDK"],
    command: "sudo updex features enable <feature> --now",
    href: "https://github.com/frostyard/updex",
  },
  {
    name: "ChairLift",
    label: "Desktop system workspace",
    mark: "CL",
    title: "A quiet cockpit for a layered system.",
    body: "A GTK 4 desktop application for keeping a Frostyard workstation in shape. It puts staged system updates, Homebrew, Flatpak, package health, and extension features in one deliberate place.",
    points: ["Stage and inspect operating system updates", "Manage Homebrew packages and trusted taps", "Work with Flatpak and extension features", "System health and maintenance shortcuts"],
    command: "chairlift",
    href: "https://github.com/frostyard/chairlift",
  },
];
---
<Site title="Tools | Frostyard" description="Frostyard tools for working with layered, updateable Linux systems." active="tools" footerLabel="Explore images →" footerHref="/">
  <header class="hero">
    <p class="eyebrow"><i></i> Tools for the layers</p>
    <h1>Keep the base still.<br /><em>Move with intent.</em></h1>
    <p class="lede">Frostyard tools have separate jobs: Firn installs the operating system, Updex manages system extensions, and ChairLift brings workstation maintenance into one control surface.</p>
  </header>

  <section class="tools" aria-label="Frostyard tools">
    {tools.map((tool, index) => <article class="tool" data-index={index}>
      <div class="tool-head"><div class="mark">{tool.mark}</div><div><p>{tool.label}</p><h2>{tool.name}</h2></div><a href={tool.href} aria-label={`Open ${tool.name} source`}>↗</a></div>
      <div class="tool-body"><div><h3>{tool.title}</h3><p>{tool.body}</p><code>{tool.command}</code></div><ul>{tool.points.map(point => <li>{point}</li>)}</ul></div>
      <a class="inspect" href={tool.href}>Inspect {tool.name} <span>↗</span></a>
    </article>)}
  </section>

  <section class="relationship"><p class="eyebrow"><i></i> Different jobs, shared direction</p><h2>Install with Firn.<br />Shape the layers deliberately.</h2><p>Updex manages system extensions. ChairLift brings updates, extension features, Homebrew, Flatpak, and system health into one desktop workspace. Neither turns the base into an accumulation of exceptions.</p></section>
</Site>

<style>
  .hero{padding:7rem 0 5.5rem;max-width:820px}
  .hero h1{font-size:var(--text-display-size);line-height:var(--text-display-lh);letter-spacing:var(--text-display-ls);font-weight:var(--text-display-weight);margin:0}
  .hero h1 em{font-family:var(--font-serif-accent);font-weight:400;color:var(--ice)}
  .lede{font-size:var(--text-lede-size);color:var(--text-muted);max-width:580px;margin:2rem 0 0}
  .tools{display:grid;gap:1rem}
  .tool{background:linear-gradient(135deg,#0e3049,#081b2c);border:1px solid var(--line);padding:var(--tool-pad)}
  .tool[data-index="1"]{background:linear-gradient(135deg,#123b55,#0a1b2b)}
  .tool[data-index="2"]{background:linear-gradient(135deg,#10344c,#081a2a)}
  .tool-head{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1rem;border-bottom:1px solid var(--line);padding-bottom:1.6rem}
  .mark{display:grid;place-items:center;width:48px;height:48px;border:1px solid #aee9ff80;background:#135477;border-radius:50%;font-weight:800;font-size:.75rem;color:var(--ice)}
  .tool-head p{font-size:.7rem;text-transform:uppercase;letter-spacing:.15em;color:#84bed5;margin:0}
  .tool-head h2{font-size:2rem;line-height:1;letter-spacing:-.06em;margin:.2rem 0 0}
  .tool-head>a{font-size:1.4rem;color:var(--ice)}
  .tool-body{display:grid;grid-template-columns:1.2fr .8fr;gap:4rem;padding:2.2rem 0}
  .tool-body h3{font-size:1.45rem;letter-spacing:-.04em;margin:0 0 .7rem}
  .tool-body p{font-size:var(--text-body-size);color:var(--text-muted);margin:0 0 1.5rem}
  .tool-body code{font-family:var(--font-mono);font-size:.73rem;color:var(--text-mono-accent);background:var(--surface-code);padding:.55rem .7rem;display:inline-block}
  .tool-body ul{list-style:none;margin:0;padding:0}
  .tool-body li{border-top:1px solid var(--line);padding:.75rem 0;color:#c0dce9;font-size:.85rem}
  .tool-body li:before{content:"✦";color:#67cdf3;font-size:.63rem;margin-right:.6rem}
  .inspect{font-size:.8rem;font-weight:700;color:#93e0fb}
  .inspect span{margin-left:.3rem}
  .relationship{margin:7rem 0 5rem;border-top:1px solid var(--line);padding-top:3rem;display:grid;grid-template-columns:1.25fr .75fr;gap:4rem;align-items:end}
  .relationship .eyebrow{grid-column:1/-1;margin:0}
  .relationship h2{font-size:clamp(2rem,3.3vw,3.5rem);line-height:1;letter-spacing:var(--text-h2-ls);margin:0}
  .relationship>p:last-child{color:var(--text-muted);font-size:var(--text-body-size);margin:0}
  @media(max-width:800px){
    .hero{padding:5rem 0 4rem}
    .tool{padding:1.4rem}
    .tool-body,.relationship{grid-template-columns:1fr;gap:2rem}
    .relationship{margin-top:5rem}
    .relationship .eyebrow{grid-column:auto}
  }
</style>
