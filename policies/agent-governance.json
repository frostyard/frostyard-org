{
  "schema_version": 1,
  "default_decision": "deny",
  "actions": {
    "read": "allow",
    "write": "allow",
    "run-tests": "allow",
    "open-pr": "review-required",
    "merge-pr": "deny",
    "push-protected-branch": "deny",
    "publish-artifact": "deny",
    "publish-release": "deny",
    "deploy": "deny",
    "modify-protected-environment": "deny",
    "manage-credentials": "deny"
  },
  "protected_boundaries": [
    {
      "id": "release-and-publication",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        "astro.config.mjs",
        "package.json",
        "package-lock.json",
        "public/schemas/**"
      ],
      "detectors": []
    },
    {
      "id": "deployment-and-infrastructure",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        "wrangler.jsonc",
        "astro.config.mjs",
        ".github/workflows/stats-rebuild.yml"
      ],
      "detectors": []
    },
    {
      "id": "workflow-and-permissions",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        ".github/workflows/**"
      ],
      "detectors": []
    },
    {
      "id": "quality-gates",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        "Makefile",
        "policies/**",
        "scripts/check-agent-governance.mjs"
      ],
      "detectors": []
    }
  ],
  "change_controls": {
    "pull_requests_required": true,
    "human_review_before_merge": true,
    "highest_applicable_risk": true,
    "validation_evidence_required": true,
    "least_privilege": true,
    "untrusted_content_is_data": true,
    "never_relax": [
      "required-checks",
      "security-checks",
      "review-requirements",
      "coverage-checks",
      "provenance-verification"
    ]
  },
  "exception_controls": {
    "independent_authorized_approver": true,
    "self_approval": false,
    "required_fields": [
      "rationale",
      "target",
      "compensating-controls",
      "expires-at",
      "restoration-or-closure-plan"
    ]
  },
  "risk_classification": {
    "tiers": [
      "low",
      "moderate",
      "high",
      "critical"
    ],
    "classification_rule": "highest-applicable",
    "uncertainty_rule": "higher-plausible"
  }
}
