{
  "name": "frostyard-org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/sync-extensions.mjs",
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "build:check": "astro build",
    "check:site": "node scripts/check-site.mjs",
    "check:prose": "node scripts/check-prose.mjs",
    "test": "node --test 'scripts/test/*.test.mjs'",
    "ci": "npm test && npm run check:prose && npm run check && npm run build:check && npm run check:site",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/starlight": "0.42.6",
    "astro": "^7.4.2",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "wrangler": "^4.151.3"
  }
}
