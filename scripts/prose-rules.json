{
  "description": "Banned phrases for docs pages under src/content/docs. scripts/check-prose.mjs enforces this list; docs/agents/skills/docs-voice.md explains it. Each pattern is a JavaScript regular expression, matched case-insensitively.",
  "rules": [
    { "pattern": "\\bpinned (?:source|sources|build|file|commit|commits|configuration)\\b", "kind": "provenance", "use": "Put the source in the Sources footer. State the fact." },
    { "pattern": "\\bthe (?:pinned |current )?sources? (?:define|defines|say|says|state|states|do not|does not|withhold|record|records|document)\\b", "kind": "provenance", "use": "State the fact, or state the limit once: \"Not tested on Snow yet.\"" },
    { "pattern": "\\bthe source's\\b", "kind": "provenance", "use": "Name the thing, not the source." },
    { "pattern": "\\bsource-backed\\b", "kind": "provenance", "use": "Drop it. Sources go in the footer." },
    { "pattern": "\\bsource evidence\\b", "kind": "provenance", "use": "Drop it. Sources go in the footer." },
    { "pattern": "\\bevidence\\b", "kind": "hedge", "use": "Say what is tested or not tested." },
    { "pattern": "\\b(?:live )?test record\\b", "kind": "hedge", "use": "Say \"Not tested on <product> yet.\"" },
    { "pattern": "\\bdesign record\\b", "kind": "hedge", "use": "State the fact." },
    { "pattern": "\\bunproven\\b", "kind": "hedge", "use": "Say what to check." },
    { "pattern": "\\bthis pilot\\b", "kind": "meta", "use": "Talk about the product, not the page set." },
    { "pattern": "\\bthese pages\\b", "kind": "meta", "use": "Talk about the product, not the page set." },
    { "pattern": "\\boperators?\\b", "kind": "voice", "use": "you" },
    { "pattern": "\\bdelv(?:e|es|ed|ing)\\b", "kind": "ai-tell", "use": "look at, explain" },
    { "pattern": "\\brobust(?:ly|ness)?\\b", "kind": "ai-tell", "use": "Say what it survives." },
    { "pattern": "\\bseamless(?:ly)?\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\bcomprehensive(?:ly)?\\b", "kind": "ai-tell", "use": "complete, full, or drop it" },
    { "pattern": "\\bleverag(?:e|es|ed|ing)\\b", "kind": "ai-tell", "use": "use" },
    { "pattern": "\\bcrucial(?:ly)?\\b", "kind": "ai-tell", "use": "Drop it, or say what breaks." },
    { "pattern": "\\bpivotal\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\bintricate\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\bmeticulous(?:ly)?\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\btapestry\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\btestament\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\blandscape\\b", "kind": "ai-tell", "use": "Name the thing." },
    { "pattern": "\\brealm\\b", "kind": "ai-tell", "use": "Name the thing." },
    { "pattern": "\\bshowcas(?:e|es|ed|ing)\\b", "kind": "ai-tell", "use": "show" },
    { "pattern": "\\bunderscor(?:e|es|ed|ing)\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\bfoster(?:s|ed|ing)?\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\bbolster(?:s|ed|ing)?\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\bstreamlin(?:e|es|ed|ing)\\b", "kind": "ai-tell", "use": "Say what got shorter." },
    { "pattern": "\\bholistic\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\beffortless(?:ly)?\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\bempower(?:s|ed|ing)?\\b", "kind": "ai-tell", "use": "lets you" },
    { "pattern": "\\bunlock(?:s|ed|ing)?\\b", "kind": "ai-tell", "use": "lets you" },
    { "pattern": "\\belevat(?:e|es|ed|ing)\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\bembark(?:s|ed|ing)?\\b", "kind": "ai-tell", "use": "start" },
    { "pattern": "\\butiliz(?:e|es|ed|ing)\\b", "kind": "ai-tell", "use": "use" },
    { "pattern": "\\bfacilitat(?:e|es|ed|ing)\\b", "kind": "ai-tell", "use": "lets, helps" },
    { "pattern": "\\bensur(?:e|es|ed|ing)\\b", "kind": "ai-tell", "use": "check, make sure, or state the result" },
    { "pattern": "\\bcutting-edge\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\bever-(?:evolving|changing)\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\bit(?: is|'s) (?:important|worth|crucial) (?:to note|noting|to remember)\\b", "kind": "ai-tell", "use": "Drop it. State the fact." },
    { "pattern": "\\bnot only\\b", "kind": "ai-tell", "use": "Two plain sentences." },
    { "pattern": "\\bfurthermore\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\bmoreover\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\badditionally\\b", "kind": "ai-tell", "use": "Drop it, or use \"also\"." },
    { "pattern": "\\bnotably\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\bin (?:summary|conclusion|essence)\\b", "kind": "ai-tell", "use": "Drop the summary." },
    { "pattern": "\\bplays? an? (?:key|vital|crucial|central|important) role\\b", "kind": "ai-tell", "use": "Say what it does." },
    { "pattern": "\\ba (?:wide|broad|diverse) (?:range|array|variety) of\\b", "kind": "ai-tell", "use": "Name them, or say \"many\"." },
    { "pattern": "\\bat its core\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\bwhether you(?:'re| are)\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "\\blet's\\b", "kind": "ai-tell", "use": "Give the step." },
    { "pattern": "\\bdive (?:into|in)\\b", "kind": "ai-tell", "use": "Give the step." },
    { "pattern": "\\bin order to\\b", "kind": "wordy", "use": "to" },
    { "pattern": "\\bin today's\\b", "kind": "ai-tell", "use": "Drop it." },
    { "pattern": "—", "kind": "ai-tell", "use": "Use a full stop, a colon, or a comma. No em dashes." }
  ]
}
